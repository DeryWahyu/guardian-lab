# Database MySQL
DATABASE_URL="mysql://root:root@localhost:3306/guardian_lab"

# JWT & Session Secret
SESSION_SECRET="your_session_secret_32_characters_minimum_here"

# DeepSeek API Key untuk analisis AI terstruktur
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Public URL Aplikasi Web
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Broker sandbox terpisah; buat kunci acak minimal 32 karakter.
SANDBOX_BROKER_KEY=
SANDBOX_BROKER_URL=http://127.0.0.1:4011
# Host stream harus satu site dengan aplikasi; HTTPS pada deployment publik.
SANDBOX_PUBLIC_URL=http://localhost:4010
